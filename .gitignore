# Artefatos de build do Quarto (regeneráveis com `quarto render`)
/.quarto/
/_site/
*_files/
*.html

# Material de terceiros — não faz parte do conteúdo autoral versionado
/material-professor-anterior/
/livros/

# Avaliações (contêm gabarito) — ficam em aulas/, mas não são publicadas
/aulas/*.gift

# Material de trabalho do professor (planos, anotações) — não é conteúdo do aluno
/BTV*.pdf
/plano-de-aula.pdf
/cnvi.txt
/apresentações-cnvi-rsfi.txt

__pycache__/
*.pyc

# Configuração local do Claude Code (não é conteúdo do curso)
/.claude/

**/*.quarto_ipynb
